<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlsRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/controls_bg"
    android:padding="10dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aim Tool"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- إضافة خط -->
        <ImageButton
            android:id="@+id/btnAddLine"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_input_add"
            android:background="#33FFFFFF"
            android:contentDescription="add"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- Bank Shot -->
        <ImageButton
            android:id="@+id/btnBank"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="#33FFFFFF"
            android:contentDescription="bank"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- مسح -->
        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="#33FFFFFF"
            android:contentDescription="clear"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- تبديل وضع التعديل / إيقاف (ضغطة طويلة) -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="#33FFFFFF"
            android:contentDescription="toggle"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
